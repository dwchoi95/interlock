{
  "uid": "service-health",
  "title": "Service Health",
  "tags": ["interlock", "rq2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom-marker" },
      "targets": [ { "refId": "A", "expr": "up" } ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prom-marker" },
      "targets": [ { "refId": "A", "expr": "rate(http_requests_total[5m])" } ]
    }
  ]
}
