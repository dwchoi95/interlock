# RQ2 Grafana case study (Section 5.3): the RQ2 image plus the pinned mcp-grafana 1.6.1 (a pypi wheel wrapping the Go
# binary; the aarch64 wheel installs natively on Apple Silicon, so no --platform emulation is needed). The server
# speaks stdio by default and authenticates to Grafana via GRAFANA_URL + GRAFANA_SERVICE_ACCOUNT_TOKEN.
FROM interlock-rq2:0806
RUN pip install --no-cache-dir mcp-grafana==1.6.1
